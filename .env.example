# Withings developer app (account.withings.com/partner/add_oauth2)
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
# Must match the registered redirect URI byte-for-byte:
WITHINGS_REDIRECT_URI=https://withings.me.mcp.example.com/withings/callback
# Encrypts per-user tokens at rest (min 16 chars). Keep secret; never commit.
WITHINGS_ENCRYPTION_KEY=
WITHINGS_STORE_PATH=/data/store.json
# Bind every call to the gateway-verified user (X-MCP-User). Required for the
# hosted, multi-user deployment so each user sees only their own data.
WITHINGS_TRUST_FORWARDED_USER=true
WITHINGS_ENABLE_WRITES=true
WITHINGS_TIMEOUT_MS=30000
WITHINGS_AUDIT_LOG=
# Shared bearer the gateway sends on /mcp (Authorization: Bearer <token>). REQUIRED
# when WITHINGS_TRUST_FORWARDED_USER=true or when binding to a non-loopback address;
# the server refuses to start without it. At least 32 printable ASCII characters,
# e.g. `openssl rand -hex 32`. Never commit.
MCP_HTTP_TOKEN=

# HTTP transport (defaults shown).
# MCP_HTTP_HOST=127.0.0.1
# PORT=3000
# MCP_MAX_BODY_BYTES=10485760
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOW_ANY_ORIGIN=false
# MCP_ALLOWED_HOSTS=
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# Serve /mcp without a token on a non-loopback bind (never with WITHINGS_TRUST_FORWARDED_USER).
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
# Optional: public origin serving /withings/connect (defaults to the origin of
# WITHINGS_REDIRECT_URI).
WITHINGS_PUBLIC_BASE_URL=
