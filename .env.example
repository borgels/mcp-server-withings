# Withings developer app (account.withings.com/partner/add_oauth2)
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
# Must match the registered redirect URI byte-for-byte:
WITHINGS_REDIRECT_URI=https://withings.me.mcp.borgels.com/withings/callback
# Encrypts per-user tokens at rest (min 16 chars). Keep secret; never commit.
WITHINGS_ENCRYPTION_KEY=
WITHINGS_STORE_PATH=/data/store.json
# Bind every call to the gateway-verified user (X-MCP-User). Required for the
# hosted, multi-user deployment so each user sees only their own data.
WITHINGS_TRUST_FORWARDED_USER=true
WITHINGS_ENABLE_WRITES=true
WITHINGS_TIMEOUT_MS=30000
WITHINGS_AUDIT_LOG=
